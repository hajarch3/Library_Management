@model List<Gestion_bibliot.Models.AdminEditViewModel>

@{
    ViewBag.Title = "Admin - Users";
}

<h2>Users</h2>
<div class="card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Admin Dashboard</h3>
    </div>

    <table class="table w-100">
        <thead>
            <tr>
                <th>Email</th>
                <th>Full Name</th>
                <th>Role</th>
                <th>Active</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Email</td>
                <td>@u.FullName</td>
                <td>@u.Role</td>
                <td>@(u.IsActive ? "Yes" : "No")</td>
                <td>
                    @Html.ActionLink("Edit", "Edit", "Admin", new { id = u.Id }, new { @class = "btn btn-sm btn-primary" })
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>


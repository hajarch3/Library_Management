@model Gestion_bibliot.Models.AdminEditViewModel

@{
    ViewBag.Title = "Edit User";
}

<h2>Edit User</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)

    <div class="form-group">
        @Html.LabelFor(m => m.Email)
        @Html.DisplayFor(m => m.Email)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.FullName)
        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Role)
        @Html.DropDownListFor(m => m.Role, new SelectList(Model.AvailableRoles), "Select role", new { @class = "form-control" })
    </div>

    <div class="checkbox">
        <label>
            @Html.CheckBoxFor(m => m.IsActive) Active
        </label>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    @Html.ActionLink("Back to list", "Index", "Admin", null, new { @class = "btn btn-default" })
}

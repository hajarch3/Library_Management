@model IEnumerable<Gestion_bibliot.Models.Author>

@{
    ViewBag.Title = "Liste des auteurs";
}

<h2>Liste des auteurs</h2>

<p>
    <a href="@Url.Action("Create", "Author")" class="btn btn-primary">
        <i class="glyphicon glyphicon-plus"></i> Ajouter un auteur
    </a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Prénom</th>
            <th>Nom</th>
            <th>Biographie</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var author in Model)
            {
                <tr>
                    <td>@author.FirstName</td>
                    <td>@author.LastName</td>
                    <td>@(author.Biography != null && author.Biography.Length > 100 ? author.Biography.Substring(0, 100) + "..." : author.Biography)</td>
                    <td>
                        <a href="@Url.Action("Details", "Author", new { id = author.Id })" class="btn btn-info btn-sm">
                            <i class="glyphicon glyphicon-eye-open"></i> Détails
                        </a>
                        <a href="@Url.Action("Edit", "Author", new { id = author.Id })" class="btn btn-warning btn-sm">
                            <i class="glyphicon glyphicon-edit"></i> Modifier
                        </a>
                        <a href="@Url.Action("Delete", "Author", new { id = author.Id })" class="btn btn-danger btn-sm">
                            <i class="glyphicon glyphicon-trash"></i> Supprimer
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">Aucun auteur enregistré</td>
            </tr>
        }
    </tbody>
</table>

@model Gestion_bibliot.Models.Subscription

<div class="card">
    <h3>Détails de l'abonnement</h3>
    <hr />

    <table class="table w-50">
        <tr><th>User</th><td>@(Model.User != null ? Model.User.FullName : Model.UserId)</td></tr>
        <tr><th>Start Date</th><td>@Model.StartDate.ToShortDateString()</td></tr>
        <tr><th>End Date</th><td>@Model.EndDate.ToShortDateString()</td></tr>
        <tr><th>Max Loans</th><td>@Model.MaxLoans</td></tr>
        <tr><th>Status</th><td>@(Model.IsActive ? "Active" : "Inactive")</td></tr>
    </table>

    <div class="mt-2">
        @Html.ActionLink("Edit", "Edit", new { id = Model.Id }, new { @class = "btn btn-primary" })
        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-link" })
    </div>
</div>

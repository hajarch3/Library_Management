@model Gestion_bibliot.Models.Subscription

<h2>Delete Subscription</h2>

<h4>Are you sure you want to delete this subscription?</h4>
<hr />

<dl class="dl-horizontal">
    <dt>User</dt>
    <dd>@Model.User.FullName</dd>

    <dt>Start Date</dt>
    <dd>@Model.StartDate.ToShortDateString()</dd>

    <dt>End Date</dt>
    <dd>@Model.EndDate.ToShortDateString()</dd>

    <dt>Max Loans</dt>
    <dd>@Model.MaxLoans</dd>

    <dt>Status</dt>
    <dd>@(Model.IsActive ? "Active" : "Inactive")</dd>
</dl>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <button type="submit" class="btn btn-danger">Delete</button>
    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary" })
}

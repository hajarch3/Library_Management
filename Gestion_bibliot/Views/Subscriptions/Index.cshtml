@model IEnumerable<Gestion_bibliot.Models.Subscription>

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="mb-0">Subscriptions</h2>
    <p>
        @Html.ActionLink("Create Subscription", "Create", null, new { @class = "btn btn-primary" })
    </p>
</div>

<table class="table w-100">
    <thead>
        <tr>
            <th>User</th>
            <th>Start</th>
            <th>End</th>
            <th>Max Loans</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr>
            <td>@s.User.FullName</td>
            <td>@s.StartDate.ToShortDateString()</td>
            <td>@s.EndDate.ToShortDateString()</td>
            <td>@s.MaxLoans</td>
            <td>@(s.IsActive ? "Active" : "Inactive")</td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = s.Id }, new { @class = "btn btn-sm btn-outline-secondary" })
                @Html.ActionLink("Delete", "Delete", new { id = s.Id }, new { @class = "btn btn-sm btn-outline-danger", onclick = "return confirm('Are you sure you want to delete this subscription?');" })
            </td>
        </tr>
    }
    </tbody>
</table>

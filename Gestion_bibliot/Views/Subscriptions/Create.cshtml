@model Gestion_bibliot.Models.Subscription

<div class="card">
    <h3>Create Subscription</h3>
    <hr />
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Student</label>
                    @Html.DropDownListFor(m => m.UserId, (SelectList)ViewBag.Users, "-- Select Student --", new { @class = "form-control" })
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    @Html.LabelFor(m => m.StartDate)
                    @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    @Html.LabelFor(m => m.EndDate)
                    @Html.TextBoxFor(m => m.EndDate, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
                </div>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.MaxLoans)
            @Html.EditorFor(m => m.MaxLoans, new { htmlAttributes = new { @class = "form-control" } })
        </div>

        <div class="mt-2">
            <button type="submit" class="btn btn-primary">Save</button>
            @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-link" })
        </div>
    }
</div>

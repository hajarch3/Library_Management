@model Gestion_bibliot.Models.Subscription

<h2>My Subscription</h2>

@if (Model == null)
{
    <div class="alert alert-warning">
        You don’t have an active subscription.
    </div>
}
else
{
    <table class="table">
        <tr><th>Start Date</th><td>@Model.StartDate.ToShortDateString()</td></tr>
        <tr><th>End Date</th><td>@Model.EndDate.ToShortDateString()</td></tr>
        <tr><th>Max Loans</th><td>@Model.MaxLoans</td></tr>
        <tr>
            <th>Status</th>
            <td>
                @(Model.IsActive && Model.EndDate >= DateTime.Today ? "Active" : "Expired")
            </td>
        </tr>
    </table>
}


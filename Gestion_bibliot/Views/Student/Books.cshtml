@model IEnumerable<Gestion_bibliot.Models.Book>
@{
    ViewBag.Title = "Livres disponibles";
}

<h2>Livres disponibles</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Titre</th>
            <th>Auteur</th>
            <th>Catégorie</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var book in Model)
    {
        <tr>
            <td>@book.Title</td>
            <td>@(book.Author != null ? book.Author.FirstName + " " + book.Author.LastName : "")</td>
            <td>@book.Category</td>
            <td>
                @Html.ActionLink("Détails", "BookDetails", "Student", new { id = book.Id }, new { @class = "btn btn-info btn-sm" })
                @using (Html.BeginForm("RequestLoan", "Student", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("bookId", book.Id)
                    <button type="submit" class="btn btn-primary btn-sm">Emprunter</button>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

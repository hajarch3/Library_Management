@model Gestion_bibliot.Models.Copy
@{
    ViewBag.Title = "Détails de l'exemplaire";
}

<h2>Détails de l'exemplaire</h2>

<div>
    <dl class="dl-horizontal">
        <dt>Livre</dt>
        <dd>@(Model.Book != null ? Model.Book.Title : "")</dd>

        <dt>Numéro de l'exemplaire</dt>
        <dd>@Model.Id</dd>

        <dt>Disponible</dt>
        <dd>@(Model.IsAvailable ? "Oui" : "Non")</dd>

        <dt>Emplacement</dt>
        <dd>@Model.ShelfLocation</dd>

        <dt>Photo</dt>
        <dd>
            @if (Model.Book != null && !string.IsNullOrEmpty(Model.Book.ImagePath))
            {
                <img src="@Url.Content(Model.Book.ImagePath)" alt="@Model.Book.Title" style="max-height:150px;" />
            }
        </dd>
    </dl>
</div>
<p>
    @Html.ActionLink("Modifier", "Edit", new { id = Model.Id }, new { @class = "btn btn-warning" })
    @Html.ActionLink("Retour à la liste", "Index", null, new { @class = "btn btn-default" })
</p>

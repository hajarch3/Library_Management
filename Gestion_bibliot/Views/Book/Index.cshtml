@model IEnumerable<Gestion_bibliot.Models.Book>

@{
    ViewBag.Title = "Liste des livres";
}

<h2>Liste des livres</h2>

<p>
    <a href="@Url.Action("Create", "Book")" class="btn btn-primary">
        <i class="glyphicon glyphicon-plus"></i> Ajouter un livre
    </a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Photo</th>
            <th>Titre</th>
            <th>ISBN</th>
            <th>Auteur</th>
            <th>Catégorie</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var book in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(book.ImagePath))
                        {
                            <img src="@book.ImagePath" alt="@book.Title" style="width: 50px; height: 70px; object-fit: cover;" />
                        }
                        else
                        {
                            <span class="glyphicon glyphicon-book" style="font-size: 40px; color: #ccc;"></span>
                        }
                    </td>
                    <td>@book.Title</td>
                    <td>@book.ISBN</td>
                    <td>@(book.Author != null ? book.Author.FirstName + " " + book.Author.LastName : "N/A")</td>
                    <td>@book.Category</td>
                    <td>
                        <a href="@Url.Action("Details", "Book", new { id = book.Id })" class="btn btn-info btn-sm">
                            <i class="glyphicon glyphicon-eye-open"></i> Détails
                        </a>
                        <a href="@Url.Action("Edit", "Book", new { id = book.Id })" class="btn btn-warning btn-sm">
                            <i class="glyphicon glyphicon-edit"></i> Modifier
                        </a>
                        <a href="@Url.Action("Delete", "Book", new { id = book.Id })" class="btn btn-danger btn-sm">
                            <i class="glyphicon glyphicon-trash"></i> Supprimer
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">Aucun livre enregistré</td>
            </tr>
        }
    </tbody>
</table>
